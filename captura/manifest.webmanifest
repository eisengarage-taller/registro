{
  "name": "EG Captura — Eisen Garage",
  "short_name": "EG Captura",
  "description": "Guarda notas, fotos, audios y documentos del taller para ordenarlos después en EG Registro.",
  "lang": "es-CL",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EEF1F2",
  "theme_color": "#1F2A30",
  "icons": [
    { "src": "icono-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icono-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "archivos", "accept": ["image/*", "audio/*", "video/*", "application/pdf", "*/*"] }]
    }
  }
}
